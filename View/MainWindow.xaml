<Window x:Class="ActiBoard.View.MainWindow"
        xmlns:controls="clr-namespace:ActiBoard.View.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ActiBoard.ViewModel"
        xmlns:view="clr-namespace:ActiBoard.View"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LocationViewModel, IsDesignTimeCreatable=True}"
        Title="MainWindow"
        Height="1080"
        Width="1920">

    <Window.Resources>
        <view:EmployeeSelectionConverter x:Key="EmployeeSelectionConverter"/>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Temaets baggrund -->
        <Image Grid.RowSpan="2"
       Source="{Binding ActiveTheme.BackgroundImagePath}"
       Stretch="UniformToFill"/>

        <controls:AnimatedThemeFrame Grid.RowSpan="2"
                                     ThemeId="{Binding ActiveTheme.Id}"
                                     IsHitTestVisible="False"/>

        <!-- Temaoverskrift og logo -->
        <Border Grid.Row="0"
        Background="Transparent">

            <Grid>

                <Button Width="70"
        Height="70"
        FontSize="34"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Margin="30,0,0,0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="🔒"/>
                            <Setter Property="Command" Value="{Binding ShowUnlockPopupCommand}"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Content" Value="🔓"/>
                                    <Setter Property="Command" Value="{Binding LockCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="+ Aktivitet"
        FontSize="20"
        Padding="20,10"
        Margin="120,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Command="{Binding ShowActivityEditorPopupCommand}">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="⚙ Administration"
        FontSize="20"
        Padding="20,10"
        Margin="120,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Command="{Binding ShowAdministrationPopupCommand}">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="{Binding ActiveTheme.Name}"
                           FontSize="60"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,56,40,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#172536"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTheme.Id}" Value="halloween">
                                    <Setter Property="Foreground" Value="#FFF8EF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTheme.Id}" Value="juleklippedag">
                                    <Setter Property="Foreground" Value="#FFF8EF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="6"
                                          ShadowDepth="0"
                                          Opacity="0.25"/>
                    </TextBlock.Effect>
                </TextBlock>




                <Border Background="White"
                        CornerRadius="12"
                        Padding="20,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,10,40,10">
                    <Image Source="/Images/KTM LOGO.png"
                           Height="80"
                           Stretch="Uniform"/>
                </Border>

            </Grid>

        </Border>

        <!-- Lokationerne -->
        <ItemsControl Grid.Row="1"
                      Margin="44,0,44,44"
                      ItemsSource="{Binding Locations}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.DashboardColumns,
                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="LocationCard"
            Margin="12"
            CornerRadius="20"
            BorderThickness="6"
            ClipToBounds="True"
            RenderTransformOrigin="0.5,0.5">

                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>

                        <Border.Effect>
                            <DropShadowEffect x:Name="GlowEffect"
                                                Color="Red"
                                                BlurRadius="0"
                                                ShadowDepth="0"
                                                Opacity="1"/>
                        </Border.Effect>

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter Property="BorderBrush" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>

                            <!-- KUN DENNE BUTTON TOGGLER -->
                            <Button x:Name="ToggleButton"
                            IsEnabled="{Binding DataContext.IsUnlocked,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    
                            Command="{Binding DataContext.ToggleLocationCommand,
                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Padding="0">

                                <Grid>
                                    <Image Source="{Binding LocationImagePath}"
                           Stretch="UniformToFill"/>

                                    <Rectangle x:Name="Overlay" Fill="#88000000"/>

                                    <controls:OutlinedTextBlock Text="{Binding Name}"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,20,0,0"/>

                                    <controls:OutlinedTextBlock x:Name="StatusBadge"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               RenderTransformOrigin="0.5,0.5"
                               Margin="0,85,0,0">

                                        <controls:OutlinedTextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </controls:OutlinedTextBlock.RenderTransform>

                                        <controls:OutlinedTextBlock.Style>
                                            <Style TargetType="controls:OutlinedTextBlock">
                                                <Setter Property="Text" Value="🔒 LUKKET"/>
                                                <Setter Property="Background" Value="#CCB00020"/>
                                                <Setter Property="Padding" Value="20,8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Text" Value="🔓 ÅBEN"/>
                                                        <Setter Property="Background" Value="#CC2E8B35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:OutlinedTextBlock.Style>
                                    </controls:OutlinedTextBlock>
                                </Grid>
                            </Button>

                            <!-- DROPDOWNS LIGGER UDENFOR BUTTON -->
                            <Grid x:Name="SelectionArea"
                                  VerticalAlignment="Bottom"
                  Margin="25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <controls:OutlinedTextBlock Text="Aktivitet"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="ActivityImage"
                                               Width="140"
                                        Height="140"
                                        Stretch="UniformToFill"
                                        Margin="0,0,10,0"
                                        Opacity="1"
                                        Source="{Binding CurrentActivity.ActivityImagePath, NotifyOnTargetUpdated=True}">

                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.25"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>

                                        <ComboBox x:Name="ActivityComboBox"
                                                  IsEnabled="{Binding DataContext.IsUnlocked,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  
                                  ItemsSource="{Binding AvailableActivities}"
                                  SelectedItem="{Binding CurrentActivity}"
                                  DisplayMemberPath="Name"
                                  Width="260"
                                  Height="45"
                                  FontSize="20"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <controls:OutlinedTextBlock Text="Ansvarlig"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="EmployeeImage"
                                            Width="140"
                                        Height="140"
                                        Stretch="UniformToFill"
                                        Margin="0,0,10,0"
                                        Opacity="1"
                                        Source="{Binding ResponsibleEmployee.EmployeeImagePath, NotifyOnTargetUpdated=True}">

                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                            From="0"
                                                            To="1"
                                                            Duration="0:0:0.25"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>

                                        <ComboBox x:Name="EmployeeComboBox"
                                                  IsEnabled="{Binding DataContext.IsUnlocked,
                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            
                                            ItemsSource="{Binding DataContext.EmployeeDropdownOptions,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  SelectedItem="{Binding ResponsibleEmployee, Mode=TwoWay, Converter={StaticResource EmployeeSelectionConverter}}"
                                  DisplayMemberPath="Name"
                                  Width="260"
                                  Height="45"
                                  FontSize="20"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>

                        <DataTrigger Binding="{Binding DataContext.DashboardColumns,
                               RelativeSource={RelativeSource AncestorType=ItemsControl}}"
             Value="3">

                            <Setter TargetName="LocationCard"
            Property="Margin"
            Value="10"/>

                            <Setter TargetName="SelectionArea"
            Property="Margin"
            Value="12"/>

                            <Setter TargetName="ActivityImage"
            Property="Width"
            Value="80"/>

                            <Setter TargetName="ActivityImage"
            Property="Height"
            Value="80"/>

                            <Setter TargetName="ActivityImage"
            Property="Margin"
            Value="0,0,6,0"/>

                            <Setter TargetName="ActivityComboBox"
            Property="Width"
            Value="190"/>

                            <Setter TargetName="ActivityComboBox"
            Property="FontSize"
            Value="17"/>

                            <Setter TargetName="EmployeeImage"
            Property="Width"
            Value="80"/>

                            <Setter TargetName="EmployeeImage"
            Property="Height"
            Value="80"/>

                            <Setter TargetName="EmployeeImage"
            Property="Margin"
            Value="0,0,6,0"/>

                            <Setter TargetName="EmployeeComboBox"
            Property="Width"
            Value="190"/>

                            <Setter TargetName="EmployeeComboBox"
            Property="FontSize"
            Value="17"/>

                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StatusBadge"
                                 Storyboard.TargetProperty="RenderTransform.ScaleX"
                                 To="1.12"
                                 Duration="0:0:0.10"
                                 AutoReverse="True"/>

                                        <DoubleAnimation Storyboard.TargetName="StatusBadge"
                                 Storyboard.TargetProperty="RenderTransform.ScaleY"
                                 To="1.12"
                                 Duration="0:0:0.10"
                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="GlowEffect"
                                Storyboard.TargetProperty="Color"
                                To="LimeGreen"
                                Duration="0:0:0.01"/>

                                        <DoubleAnimation Storyboard.TargetName="GlowEffect"
                                 Storyboard.TargetProperty="BlurRadius"
                                 From="0"
                                 To="35"
                                 Duration="0:0:0.15"
                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>

                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="GlowEffect"
                                Storyboard.TargetProperty="Color"
                                To="Red"
                                Duration="0:0:0.01"/>

                                        <DoubleAnimation Storyboard.TargetName="GlowEffect"
                                 Storyboard.TargetProperty="BlurRadius"
                                 From="0"
                                 To="35"
                                 Duration="0:0:0.15"
                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <EventTrigger SourceName="ToggleButton"
                  RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="LocationCard"
                                 Storyboard.TargetProperty="RenderTransform.ScaleX"
                                 To="1.03"
                                 Duration="0:0:0.08"
                                 AutoReverse="True"/>

                                    <DoubleAnimation Storyboard.TargetName="LocationCard"
                                 Storyboard.TargetProperty="RenderTransform.ScaleY"
                                 To="1.03"
                                 Duration="0:0:0.08"
                                 AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Overlay"
                                    Storyboard.TargetProperty="Fill.Color"
                                    To="#00000000"
                                    Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>

                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Overlay"
                                    Storyboard.TargetProperty="Fill.Color"
                                    To="#88000000"
                                    Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:PopupHost Grid.RowSpan="2"
                              Panel.ZIndex="100"/>

    </Grid>
</Window>
