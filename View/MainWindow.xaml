<Window x:Class="ActiBoard.View.MainWindow"
        xmlns:controls="clr-namespace:ActiBoard.View.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ActiBoard.ViewModel"
        xmlns:view="clr-namespace:ActiBoard.View"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LocationViewModel, IsDesignTimeCreatable=True}"
        Title="MainWindow"
        Height="1080"
        Width="1920">

    <Window.Resources><view:ThemeIconConverter x:Key="ThemeIconConverter"/>
        <view:EmployeeSelectionConverter x:Key="EmployeeSelectionConverter"/>
        <Style x:Key="TransparentImageButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Temaets baggrund -->
        <Image Grid.RowSpan="2"
       Source="{Binding ActiveTheme.BackgroundImagePath}"
       Stretch="UniformToFill"/>

        <controls:AnimatedThemeFrame Grid.RowSpan="2" ShowFrame="False"
                                     BackgroundColor="{Binding ActiveTheme.BackgroundColor}"
                                     ThemeId="{Binding ActiveTheme.Id}"
                                     IsHitTestVisible="False"/>

        <!-- Temaoverskrift og logo -->
        <Border Grid.Row="0"
        Background="Transparent">

            <Grid>

                <Button Width="70"
        Height="70"
        FontSize="34"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Margin="30,0,0,0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="🔒"/>
                            <Setter Property="Command" Value="{Binding ShowUnlockPopupCommand}"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Content" Value="🔓"/>
                                    <Setter Property="Command" Value="{Binding LockCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="+ Aktivitet"
        FontSize="20"
        Padding="20,10"
        Margin="120,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Command="{Binding ShowActivityEditorPopupCommand}">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="⚙ Administration"
        FontSize="20"
        Padding="20,10"
        Margin="120,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Command="{Binding ShowAdministrationPopupCommand}">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
 <Image Width="64" Height="64" Stretch="Uniform" Margin="0,0,16,0" Source="{Binding ActiveTheme.Id, Converter={StaticResource ThemeIconConverter}}">
  <Image.Style><Style TargetType="Image"><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style>
 </Image><TextBlock Text="{Binding ActiveTheme.Name}"
                           Foreground="{Binding ActiveTheme.TitleForeground}" FontSize="60"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0">
                    
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="6"
                                          ShadowDepth="0"
                                          Opacity="0.25"/>
                    </TextBlock.Effect>
                </TextBlock><Image Width="64" Height="64" Stretch="Uniform" Margin="16,0,0,0" Source="{Binding ActiveTheme.Id, Converter={StaticResource ThemeIconConverter}}">
  <Image.Style><Style TargetType="Image"><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Image.Style>
 </Image></StackPanel>




                <Border Background="White"
                        CornerRadius="12"
                        Padding="20,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,10,40,10">
                    <Image Source="pack://application:,,,/ActiBoard;component/Images/ActiBoard-logo.png" Width="300"
                           Height="80"
                           Stretch="Uniform"/>
                </Border>

            </Grid>

        </Border>

        <!-- Lokationerne -->
        <ItemsControl Grid.Row="1"
                      Margin="12,0,12,12"
                      ItemsSource="{Binding Locations}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.DashboardColumns,
                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="LocationCard"
            Margin="12"
            CornerRadius="20"
            BorderThickness="6"
            ClipToBounds="True"
            RenderTransformOrigin="0.5,0.5">

                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>

                        <Border.Effect>
                            <DropShadowEffect x:Name="GlowEffect"
                                                Color="Red"
                                                BlurRadius="0"
                                                ShadowDepth="0"
                                                Opacity="1"/>
                        </Border.Effect>

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter Property="BorderBrush" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <controls:RoundedLocationGrid>

                            <!-- KUN DENNE BUTTON TOGGLER -->
                            <Button x:Name="ToggleButton"
                            IsEnabled="{Binding DataContext.IsUnlocked,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    
                            Command="{Binding DataContext.ToggleLocationCommand,
                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            BorderThickness="0"
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Padding="0">

                                <Grid>
                                    <Image Source="{Binding LocationImagePath}" Stretch="UniformToFill"/>

                                    <Rectangle x:Name="Overlay" Fill="#BF000000"/>

                                    <Border Background="#85000000" CornerRadius="12" Padding="18,5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,16,12,0">
 <controls:OutlinedTextBlock Text="{Binding Name}" FontSize="38" FontWeight="Bold" Foreground="White"/>
</Border>

                                    <controls:OutlinedTextBlock x:Name="StatusBadge"
                               FontSize="32"
                               BackgroundCornerRadius="12"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               RenderTransformOrigin="0.5,0.5"
                               Margin="0,85,0,0">

                                        <controls:OutlinedTextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </controls:OutlinedTextBlock.RenderTransform>

                                        <controls:OutlinedTextBlock.Style>
                                            <Style TargetType="controls:OutlinedTextBlock">
                                                <Setter Property="Text" Value="🔒 LUKKET"/>
                                                <Setter Property="Background" Value="#B00020"/>
                                                <Setter Property="Padding" Value="28,10"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Text" Value="🔓 ÅBEN"/>
                                                        <Setter Property="Background" Value="#16763A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:OutlinedTextBlock.Style>
                                    </controls:OutlinedTextBlock>
                                </Grid>
                            </Button>

                            <!-- DROPDOWNS LIGGER UDENFOR BUTTON -->
                            <Grid x:Name="SelectionArea"
                                  VerticalAlignment="Bottom"
                  Margin="25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    

                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource TransparentImageButton}" Background="Transparent" BorderThickness="0" Padding="0"
 IsEnabled="{Binding DataContext.IsUnlocked, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
 Command="{Binding DataContext.ShowActivityPickerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
 CommandParameter="{Binding}" AutomationProperties.Name="Vælg aktivitet"><Image x:Name="ActivityImage"
                                               Width="140"
                                        Height="140"
                                        Stretch="UniformToFill"
                                        Margin="0,0,10,0"
                                        Opacity="1"
                                        Source="{Binding CurrentActivity.ActivityImagePath, NotifyOnTargetUpdated=True}">

                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.25"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image></Button>

                                        <StackPanel VerticalAlignment="Center"><Border x:Name="ActivityLabel" Background="#85000000" CornerRadius="9" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,4"><controls:OutlinedTextBlock Text="Aktivitet" Foreground="White" FontSize="25" FontWeight="Bold"/></Border><Button x:Name="ActivityComboBox"
 IsEnabled="{Binding DataContext.IsUnlocked, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
 Command="{Binding DataContext.ShowActivityPickerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
 CommandParameter="{Binding}" Width="260" Height="45" VerticalAlignment="Center" FontSize="20" Padding="8,2">
 <TextBlock TextTrimming="CharacterEllipsis" TextAlignment="Center">
  <TextBlock.Style><Style TargetType="TextBlock">
   <Setter Property="Text" Value="{Binding CurrentActivity.Name}"/>
   <Style.Triggers><DataTrigger Binding="{Binding CurrentActivity}" Value="{x:Null}"><Setter Property="Text" Value="Vælg aktivitet…"/></DataTrigger></Style.Triggers>
  </Style></TextBlock.Style>
 </TextBlock>
</Button></StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    

                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource TransparentImageButton}" Background="Transparent" BorderThickness="0" Padding="0"
 IsEnabled="{Binding DataContext.IsUnlocked, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
 Command="{Binding DataContext.ShowEmployeePickerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
 CommandParameter="{Binding}" AutomationProperties.Name="Vælg ansvarlig"><Image x:Name="EmployeeImage"
                                            Width="140"
                                        Height="140"
                                        Stretch="UniformToFill"
                                        Margin="0,0,10,0"
                                        Opacity="1"
                                        Source="{Binding ResponsibleEmployee.EmployeeImagePath, NotifyOnTargetUpdated=True}">

                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                            From="0"
                                                            To="1"
                                                            Duration="0:0:0.25"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image></Button>

                                        <StackPanel VerticalAlignment="Center"><Border x:Name="EmployeeLabel" Background="#85000000" CornerRadius="9" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,4"><controls:OutlinedTextBlock Text="Ansvarlig" Foreground="White" FontSize="25" FontWeight="Bold"/></Border><Button x:Name="EmployeeComboBox"
 IsEnabled="{Binding DataContext.IsUnlocked, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
 Command="{Binding DataContext.ShowEmployeePickerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
 CommandParameter="{Binding}" Width="260" Height="45" VerticalAlignment="Center" FontSize="20" Padding="8,2">
 <TextBlock TextTrimming="CharacterEllipsis" TextAlignment="Center">
  <TextBlock.Style><Style TargetType="TextBlock">
   <Setter Property="Text" Value="{Binding ResponsibleEmployee.Name}"/>
   <Style.Triggers><DataTrigger Binding="{Binding ResponsibleEmployee}" Value="{x:Null}"><Setter Property="Text" Value="Vælg ansvarlig…"/></DataTrigger></Style.Triggers>
  </Style></TextBlock.Style>
 </TextBlock>
</Button></StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                        </controls:RoundedLocationGrid>
                    </Border>
                    <DataTemplate.Triggers>

                        <DataTrigger Binding="{Binding DataContext.DashboardColumns,
                               RelativeSource={RelativeSource AncestorType=ItemsControl}}"
             Value="3">



                            <Setter TargetName="LocationCard"
            Property="Margin"
            Value="10"/>

                            <Setter TargetName="SelectionArea"
            Property="Margin"
            Value="12"/>

                            <Setter TargetName="ActivityImage"
            Property="Width"
            Value="80"/>

                            <Setter TargetName="ActivityImage"
            Property="Height"
            Value="80"/>

                            <Setter TargetName="ActivityImage"
            Property="Margin"
            Value="0,0,6,0"/>

                            <Setter TargetName="ActivityComboBox"
            Property="Width"
            Value="190"/>

                            <Setter TargetName="ActivityComboBox"
            Property="FontSize"
            Value="17"/>

                            <Setter TargetName="EmployeeImage"
            Property="Width"
            Value="80"/>

                            <Setter TargetName="EmployeeImage"
            Property="Height"
            Value="80"/>

                            <Setter TargetName="EmployeeImage"
            Property="Margin"
            Value="0,0,6,0"/>

                            <Setter TargetName="EmployeeComboBox"
            Property="Width"
            Value="190"/>

                            <Setter TargetName="EmployeeComboBox"
            Property="FontSize"
            Value="17"/>

                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StatusBadge"
                                 Storyboard.TargetProperty="RenderTransform.ScaleX"
                                 To="1.12"
                                 Duration="0:0:0.10"
                                 AutoReverse="True"/>

                                        <DoubleAnimation Storyboard.TargetName="StatusBadge"
                                 Storyboard.TargetProperty="RenderTransform.ScaleY"
                                 To="1.12"
                                 Duration="0:0:0.10"
                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="GlowEffect"
                                Storyboard.TargetProperty="Color"
                                To="LimeGreen"
                                Duration="0:0:0.01"/>

                                        <DoubleAnimation Storyboard.TargetName="GlowEffect"
                                 Storyboard.TargetProperty="BlurRadius"
                                 From="0"
                                 To="35"
                                 Duration="0:0:0.15"
                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>

                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="GlowEffect"
                                Storyboard.TargetProperty="Color"
                                To="Red"
                                Duration="0:0:0.01"/>

                                        <DoubleAnimation Storyboard.TargetName="GlowEffect"
                                 Storyboard.TargetProperty="BlurRadius"
                                 From="0"
                                 To="35"
                                 Duration="0:0:0.15"
                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <EventTrigger SourceName="ToggleButton"
                  RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="LocationCard"
                                 Storyboard.TargetProperty="RenderTransform.ScaleX"
                                 To="1.03"
                                 Duration="0:0:0.08"
                                 AutoReverse="True"/>

                                    <DoubleAnimation Storyboard.TargetName="LocationCard"
                                 Storyboard.TargetProperty="RenderTransform.ScaleY"
                                 To="1.03"
                                 Duration="0:0:0.08"
                                 AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Overlay"
                                    Storyboard.TargetProperty="Fill.Color"
                                    To="#00000000"
                                    Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>

                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Overlay"
                                    Storyboard.TargetProperty="Fill.Color"
                                    To="#BF000000"
                                    Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:PopupHost Grid.RowSpan="2"
                              Panel.ZIndex="100"/>

    </Grid>
</Window>
