<UserControl x:Class="ActiBoard.View.Controls.ActivityManagerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#66000000">
        <Border Width="760"
                Height="720"
                Background="White"
                CornerRadius="25"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
      Margin="0,0,0,20">

                    <Button Content="← Administration"
            Width="170"
            Height="42"
            FontSize="18"
            FontWeight="SemiBold"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Command="{Binding BackToAdministrationCommand}"
            Panel.ZIndex="1"/>

                    <TextBlock Text="Aktiviteter"
               FontSize="32"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Panel.ZIndex="0"/>

                    <Button Content="✕"
            Width="42"
            Height="42"
            FontSize="20"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding ClosePopupCommand}"
            Panel.ZIndex="1"/>
                </Grid>

                <TextBox Grid.Row="1"
                         Height="48"
                         FontSize="20"
                         Margin="0,10,0,20"
                         ToolTip="Søg aktivitet"/>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Activities}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Source="{Binding ActivityImagePath}"
                                       Width="60"
                                       Height="60"
                                       Stretch="UniformToFill"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="22"
                                           VerticalAlignment="Center"
                                           Margin="15,0"/>

                                <Button Grid.Column="2"
                                        Content="✏"
                                        Width="70"
                                        Height="55"
                                        FontSize="26"
                                        Margin="5"
                                        ToolTip="Rediger aktivitet"
                                        Command="{Binding DataContext.ShowActivityEditorPopupCommand,
                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>

                                <Button Grid.Column="3"
                                        Content="🗑"
                                        Width="70"
                                        Height="55"
                                        FontSize="24"
                                        Margin="5"
                                        ToolTip="Slet aktivitet"
                                        Command="{Binding DataContext.ShowDeleteActivityConfirmationCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="3"
                        Content="+ Ny aktivitet"
                        Height="52"
                        FontSize="22"
                        FontWeight="Bold"
                        Background="LimeGreen"
                        Foreground="White"
                        Margin="0,20,0,0"
                        Command="{Binding ShowActivityEditorPopupCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
