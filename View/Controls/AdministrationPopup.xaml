<UserControl x:Class="ActiBoard.View.Controls.AdministrationPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#66000000">
        <Border Width="560"
                Background="White"
                CornerRadius="25"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="✕"
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        Command="{Binding ClosePopupCommand}"/>

                <TextBlock Grid.Row="0"
                           Text="Administration"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,30"/>

                <Button Grid.Row="1"
                        Height="70"
                        FontSize="24"
                        Margin="0,10"
                        Command="{Binding ShowActivityManagerPopupCommand}"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/ActiBoard;component/Images/Navigation/Aktiviteter.png" Width="46" Height="46" Stretch="Uniform" Margin="0,0,16,0"/><TextBlock Text="Aktiviteter" VerticalAlignment="Center"/></StackPanel></Button>

                <Button Grid.Row="2"
                        Height="70"
                        FontSize="24"
                        Margin="0,10"
                        Command="{Binding ShowEmployeeManagerPopupCommand}"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/ActiBoard;component/Images/Navigation/Medarbejdere.png" Width="46" Height="46" Stretch="Uniform" Margin="0,0,16,0"/><TextBlock Text="Medarbejdere" VerticalAlignment="Center"/></StackPanel></Button>

                <Button Grid.Row="3"
                        Height="70"
                        FontSize="24"
                        Margin="0,10"
                        Command="{Binding ShowLocationManagerPopupCommand}"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/ActiBoard;component/Images/Navigation/Lokationer.png" Width="46" Height="46" Stretch="Uniform" Margin="0,0,16,0"/><TextBlock Text="Lokationer" VerticalAlignment="Center"/></StackPanel></Button>

                <Button Grid.Row="4"
                        Height="70"
                        FontSize="24"
                        Margin="0,10"
                        Command="{Binding ShowThemeManagerPopupCommand}"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/ActiBoard;component/Images/Navigation/Temaer.png" Width="46" Height="46" Stretch="Uniform" Margin="0,0,16,0"/><TextBlock Text="Temaer" VerticalAlignment="Center"/></StackPanel></Button>

                <Button Grid.Row="5"
                        Command="{Binding ShowSettingsPopupCommand}"
                        Height="70"
                        FontSize="24"
                        Margin="0,10"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/ActiBoard;component/Images/Navigation/Indstillinger.png" Width="46" Height="46" Stretch="Uniform" Margin="0,0,16,0"/><TextBlock Text="Indstillinger" VerticalAlignment="Center"/></StackPanel></Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
