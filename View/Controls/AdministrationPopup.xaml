<UserControl x:Class="ActiBoard.View.Controls.AdministrationPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#66000000">
        <Border Width="560"
                Background="White"
                CornerRadius="25"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="✕"
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        Command="{Binding ClosePopupCommand}"/>

                <TextBlock Grid.Row="0"
                           Text="Administration"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,30"/>

                <Button Grid.Row="1"
                        Content="🎯  Aktiviteter"
                        Height="70"
                        FontSize="24"
                        Margin="0,10"
                        Command="{Binding ShowActivityManagerPopupCommand}"/>

                <Button Grid.Row="2"
                        Content="👤  Medarbejdere"
                        Height="70"
                        FontSize="24"
                        Margin="0,10"
                        Command="{Binding ShowEmployeeManagerPopupCommand}"/>

                <Button Grid.Row="3"
                        Content="📍  Lokationer"
                        Height="70"
                        FontSize="24"
                        Margin="0,10"
                        Command="{Binding ShowLocationManagerPopupCommand}"/>

                <Button Grid.Row="4"
                        Content="🎉  Temaer"
                        Height="70"
                        FontSize="24"
                        Margin="0,10"
                        Command="{Binding ShowThemeManagerPopupCommand}"/>

                <Button Grid.Row="5"
                        Content="⚙  Indstillinger"
                        Command="{Binding ShowSettingsPopupCommand}"
                        Height="70"
                        FontSize="24"
                        Margin="0,10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
