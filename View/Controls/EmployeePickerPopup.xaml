<UserControl x:Class="ActiBoard.View.Controls.EmployeePickerPopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="#99000000">
  <Border Background="White" CornerRadius="20" Padding="28" Margin="40" MaxWidth="1200" MaxHeight="850">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding EmployeePickerTitle}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,20"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
     <StackPanel>
      <Button Content="Ingen ansvarlig" Command="{Binding ChooseLocationEmployeeCommand}" FontSize="24" Height="65" Margin="8,0,8,14"/>
      <TextBlock Text="Der er ingen medarbejdere at vælge." FontSize="22" Margin="8" TextWrapping="Wrap">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EmployeePickerOptions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <ItemsControl ItemsSource="{Binding EmployeePickerOptions}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Button Width="240" Height="230" Margin="8" Padding="12" Background="#F5F7FA" Command="{Binding DataContext.ChooseLocationEmployeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
         <StackPanel><Image Source="{Binding EmployeeImagePath}" Width="180" Height="150" Stretch="Uniform"/><TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="2" Content="Annuller" Command="{Binding ClosePopupCommand}" FontSize="22" Padding="28,12" HorizontalAlignment="Right" Margin="0,20,0,0"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
