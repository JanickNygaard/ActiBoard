<UserControl x:Class="ActiBoard.View.Controls.LocationManagerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#66000000"
          Panel.ZIndex="100">

        <Border Width="820"
                MaxHeight="850"
                Background="White"
                CornerRadius="25"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tilbage til administration -->
                <Button Grid.Row="0"
                        Content="← Administration"
                        Height="42"
                        Padding="12,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Command="{Binding BackToAdministrationCommand}"/>

                <!-- Luk alle popups -->
                <Button Grid.Row="0"
                        Content="✕"
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding ClosePopupCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"/>

                <TextBlock Grid.Row="0"
                           Text="Lokationer"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                <!-- Opret ny lokation -->
                <Button Grid.Row="1"
                        Content="+ Tilføj lokation"
                        Height="52"
                        Width="220"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,20"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Background="LimeGreen"
                        Foreground="White"
                        Command="{Binding ShowLocationEditorPopupCommand}"/>

                <!-- Lokationsliste -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding Locations}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#F4F4F4"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14"
                                        Margin="0,0,0,12">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Lokationsbillede -->
                                        <Border Grid.Column="0"
                                                Width="95"
                                                Height="75"
                                                CornerRadius="12"
                                                ClipToBounds="True"
                                                BorderBrush="#CCCCCC"
                                                BorderThickness="1"
                                                HorizontalAlignment="Left">

                                            <Image Source="{Binding LocationImagePath}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Lokationsnavn -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="15,0"/>

                                        <!-- Rediger -->
                                        <Button Grid.Column="2"
                                                Content="Rediger"
                                                Width="100"
                                                Height="46"
                                                Margin="5,0"
                                                FontSize="17"
                                                Command="{Binding DataContext.ShowLocationEditorPopupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <!-- Slet -->
                                        <Button Grid.Column="3"
                                                Content="Slet"
                                                Width="90"
                                                Height="46"
                                                Margin="5,0"
                                                FontSize="17"
                                                Background="#D64545"
                                                Foreground="White"
                                                Command="{Binding DataContext.ShowDeleteLocationConfirmationCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
