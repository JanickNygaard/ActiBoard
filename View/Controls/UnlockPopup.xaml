<UserControl x:Class="ActiBoard.View.Controls.UnlockPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ActiBoard.View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Grid.RowSpan="2"
            Panel.ZIndex="100"
      Background="#66000000">


        <Border x:Name="PopupBorder"
            Width="460"
            Height="750"
            Background="White"
            CornerRadius="25"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Grid>

                <!-- Luk-knap -->
                <Button Width="42"
        Height="42"
        Content="✕"
        FontSize="20"
        FontWeight="Bold"
        BorderThickness="0"
        Background="Red"
        Foreground="White"
        Cursor="Hand"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Click="CancelUnlockButton_Click">
                </Button>

                <StackPanel Margin="0,20,0,0">

                    <TextBlock Text="🔒"
                       FontSize="54"
                       HorizontalAlignment="Center"/>

                    <TextBlock Text="Lås ActiBoard op"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,20"/>

                    <TextBox x:Name="UnlockCodeBox"
         Height="60"
         FontSize="32"
         FontWeight="Bold"
         IsReadOnly="True"
         TextAlignment="Center"
         VerticalContentAlignment="Center"
         MaxLength="4"
         Background="#F2F2F2"
         BorderBrush="#333333"
         BorderThickness="2"/>

                    <TextBlock x:Name="ErrorText"
           Text="❌ Forkert kode"
           FontSize="18"
           FontWeight="SemiBold"
           Foreground="Red"
           HorizontalAlignment="Center"
           Margin="0,15,0,0"
           Visibility="Collapsed"/>

                    <UniformGrid Columns="3" Rows="4" Margin="0,30,0,0">
                        <UniformGrid.Resources>
                            <Style TargetType="Button">
                                <Setter Property="FontSize" Value="32"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="75"/>
                                <Setter Property="Margin" Value="8"/>
                                <Setter Property="Background" Value="#F2F2F2"/>
                                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="2"
                                                          Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="14">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </UniformGrid.Resources>

                        <Button Content="1" Click="NumberButton_Click"/>
                        <Button Content="2" Click="NumberButton_Click"/>
                        <Button Content="3" Click="NumberButton_Click"/>

                        <Button Content="4" Click="NumberButton_Click"/>
                        <Button Content="5" Click="NumberButton_Click"/>
                        <Button Content="6" Click="NumberButton_Click"/>

                        <Button Content="7" Click="NumberButton_Click"/>
                        <Button Content="8" Click="NumberButton_Click"/>
                        <Button Content="9" Click="NumberButton_Click"/>

                        <Button Content="←" Click="BackspaceButton_Click"/>
                        <Button Content="0" Click="NumberButton_Click"/>
                        <Button Content="✓" Click="UnlockButton_Click" Background="LimeGreen" Foreground="White"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
