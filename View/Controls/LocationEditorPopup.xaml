<UserControl x:Class="ActiBoard.View.Controls.LocationEditorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#66000000"
          Panel.ZIndex="100">

        <Border Width="560"
                Background="White"
                CornerRadius="25"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tilbage til listen over lokationer -->
                <Button Grid.Row="0"
                        Content="← Lokationer"
                        Width="90"
                        Height="42"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Command="{Binding BackToLocationManagerCommand}"/>

                <!-- Luk hele popupområdet -->
                <Button Grid.Row="0"
                        Content="✕"
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding ClosePopupCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"/>

                <TextBlock Grid.Row="0"
                           Text="Tilføj lokation"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                <!-- Navn -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Navn"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="LocationNameTextBox"
                             Text="{Binding LocationEditorName,
                                            UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="False"
                             Height="55"
                             FontSize="22"
                             VerticalContentAlignment="Center"
                             Padding="12,0"/>
                </StackPanel>

                <!-- Billede -->
                <StackPanel Grid.Row="2"
                            Margin="0,20,0,0">

                    <TextBlock Text="Billede"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <Border Width="240"
                            Height="170"
                            BorderBrush="#CCCCCC"
                            BorderThickness="2"
                            CornerRadius="15"
                            Margin="0,10,0,10"
                            HorizontalAlignment="Left"
                            ClipToBounds="True">

                        <Image Source="{Binding LocationEditorImagePath}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <Button Content="Fra computer"
                            Width="160"
                            Height="45"
                            HorizontalAlignment="Left"
                            Click="ChooseImageButton_Click"/>
                    <Button Content="Vælg fra galleri" Width="180" Height="45"
                            Margin="0,8,0,0" HorizontalAlignment="Left"
                            Command="{Binding OpenImageGalleryCommand}"/>
                </StackPanel>

                <!-- Gem -->
                <Button Grid.Row="3"
                        Content="Gem lokation"
                        Height="52"
                        FontSize="20"
                        FontWeight="Bold"
                        Background="LimeGreen"
                        Foreground="White"
                        Margin="0,30,0,0"
                        Click="SaveLocationButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>