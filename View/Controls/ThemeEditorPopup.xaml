<UserControl x:Class="ActiBoard.View.Controls.ThemeEditorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#66000000">

        <Border Width="560"
                Background="White"
                CornerRadius="25"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="← Temaer"
                        Width="100"
                        Height="42"
                        HorizontalAlignment="Left"
                        Command="{Binding BackToThemeManagerCommand}"/>

                <TextBlock Grid.Row="0"
                           Text="Tema"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Button Grid.Row="0"
                        Content="✕"
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        Command="{Binding ClosePopupCommand}"/>

                <StackPanel Grid.Row="1"
                            Margin="0,35,0,0">

                    <TextBlock Text="Navn"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBox Text="{Binding ThemeEditorName,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="55"
                             FontSize="22"
                             VerticalContentAlignment="Center"
                             Padding="12,0"
                             Margin="0,8,0,0"/>
                    <TextBlock Text="Baggrund"
           FontSize="20"
           FontWeight="Bold"
           Margin="0,20,0,8"/>

                    <Border Height="230"
        BorderBrush="#CCCCCC"
        BorderThickness="1"
        CornerRadius="10"
        Background="#F3F3F3">

                        <Image Source="{Binding ThemeEditorBackgroundImagePath}"
           Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
            Margin="0,12,0,0">

                        <Button Content="Vælg baggrund"
            Width="180"
            Height="50"
            FontSize="17"
            Command="{Binding SelectThemeBackgroundCommand}"/>

    <Button Content="Fjern baggrund"
            Width="180"
            Height="50"
            Margin="10,0,0,0"
            FontSize="17"
            Command="{Binding RemoveThemeBackgroundCommand}"/>
                    </StackPanel>

                </StackPanel>

                <Button Grid.Row="2"
                        Content="Gem tema"
                        Height="52"
                        FontSize="20"
                        FontWeight="Bold"
                        Background="LimeGreen"
                        Foreground="White"
                        Margin="0,35,0,0"
                        Command="{Binding SaveThemeCommand}"/>

            </Grid>
        </Border>
    </Grid>
</UserControl>
