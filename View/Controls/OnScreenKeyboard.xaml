<UserControl x:Class="ActiBoard.View.Controls.OnScreenKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="KeyboardButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="58"/>

            <Setter Property="Margin"
                    Value="4"/>

            <Setter Property="FontSize"
                    Value="22"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#CCCCCC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

    </UserControl.Resources>

    <Border Background="#F2F2F2"
        BorderBrush="#CCCCCC"
        BorderThickness="1"
        CornerRadius="18"
        Padding="14">

        <Grid>

            <!-- Luk-knap i øverste højre hjørne -->
            <Button Content="✕"
                Width="48"
                Height="48"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0"
                FontSize="22"
                FontWeight="Bold"
                Focusable="False"
                Background="Red"
                Foreground="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Click="DoneButton_Click"
                Panel.ZIndex="10"/>

            <StackPanel Margin="0,55,0,0">


                <!-- Første række -->

                <UniformGrid Columns="10">


                    <Button Content="Q"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="W"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="E"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="R"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="T"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="Y"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="U"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="I"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="O"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="P"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                </UniformGrid>

                <!-- Anden række -->

                <UniformGrid Columns="11"
                         Margin="25,0">

                    <Button Content="A"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="S"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="D"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="F"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="G"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="H"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="J"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="K"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="L"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="Æ"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                    <Button Content="Ø"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="CharacterButton_Click"/>

                </UniformGrid>

                <!-- Tredje række -->

                <Grid Margin="55,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>

                    <UniformGrid Grid.Column="0"
                             Columns="8">

                        <Button Content="Z"
                            Style="{StaticResource KeyboardButtonStyle}"
                            Click="CharacterButton_Click"/>

                        <Button Content="X"
                            Style="{StaticResource KeyboardButtonStyle}"
                            Click="CharacterButton_Click"/>

                        <Button Content="C"
                            Style="{StaticResource KeyboardButtonStyle}"
                            Click="CharacterButton_Click"/>

                        <Button Content="V"
                            Style="{StaticResource KeyboardButtonStyle}"
                            Click="CharacterButton_Click"/>

                        <Button Content="B"
                            Style="{StaticResource KeyboardButtonStyle}"
                            Click="CharacterButton_Click"/>

                        <Button Content="N"
                            Style="{StaticResource KeyboardButtonStyle}"
                            Click="CharacterButton_Click"/>

                        <Button Content="M"
                            Style="{StaticResource KeyboardButtonStyle}"
                            Click="CharacterButton_Click"/>

                        <Button Content="Å"
                            Style="{StaticResource KeyboardButtonStyle}"
                            Click="CharacterButton_Click"/>

                    </UniformGrid>

                    <Button Grid.Column="1"
                        Content="⌫"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="BackspaceButton_Click"/>

                </Grid>

                <!-- Nederste række -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                        x:Name="ShiftButton"
                        Content="Skift"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="ShiftButton_Click"/>

                    <Button Grid.Column="1"
                        Content="Mellemrum"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="SpaceButton_Click"/>

                    <Button Grid.Column="2"
                        Content="Færdig"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Background="LimeGreen"
        Foreground="White"
                        FontWeight="Bold"
                        Click="DoneButton_Click"/>

                </Grid>

            </StackPanel>
        </Grid>
    </Border>

</UserControl>